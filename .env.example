# Pool transacional do Supabase, usado pela aplicação.
DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=require"

# Conexão direta do Supabase, usada pelo Prisma CLI e pelas migrations.
