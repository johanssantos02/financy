generator client {
  provider = "prisma-client"
  output   = "../src/shared/api/prisma/gerado"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")

  @@map("user_roles")
}

enum MembroFuncao {
  PROPRIETARIO @map("owner")
  MEMBRO       @map("member")

  @@map("member_roles")
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  email             String               @unique
  phone             String?
  passwordHash      String               @map("password_hash")
  role              UserRole             @default(USER)
  contasFamilia     ContaFamiliaMembro[]
  despesasCriadas   Despesa[]            @relation("DespesaCriadaPor")
  pagamentosDespesa PagamentoDespesa[]   @relation("PagamentoDespesaPagoPor")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model ContaFamilia {
  id           String               @id @default(uuid()) @db.Uuid
  nome         String
  membros      ContaFamiliaMembro[]
  despesas     Despesa[]
  tags         Tag[]
  criadoEm     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  atualizadoEm DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("family_accounts")
}

model ContaFamiliaMembro {
  usuario        User         @relation(fields: [usuarioId], references: [id])
  usuarioId      String       @map("user_id") @db.Uuid
  contaFamilia   ContaFamilia @relation(fields: [contaFamiliaId], references: [id])
  contaFamiliaId String       @map("family_account_id") @db.Uuid
  funcao         MembroFuncao @default(MEMBRO) @map("role")
  entradoEm      DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)

  @@id([usuarioId, contaFamiliaId])
  @@map("user_family_accounts")
}

model Despesa {
  id              String             @id @default(uuid()) @db.Uuid
  contaFamilia    ContaFamilia       @relation(fields: [contaFamiliaId], references: [id])
  contaFamiliaId  String             @map("family_account_id") @db.Uuid
  nome            String             @map("name")
  nomeNormalizado String?            @map("normalized_name")
  valor           Decimal            @map("amount") @db.Decimal(12, 2)
  vencimento      DateTime           @map("due_date") @db.Date
  lancamento      DateTime           @map("entry_date") @db.Date
  recorrente      Boolean            @default(false) @map("recurring")
  descricao       String?            @map("description")
  criadoPor       User               @relation("DespesaCriadaPor", fields: [criadoPorId], references: [id])
  criadoPorId     String             @map("created_by") @db.Uuid
  pagamentos      PagamentoDespesa[]
  tags            DespesaTag[]
  criadoEm        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  atualizadoEm    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  excluidoEm      DateTime?          @map("deleted_at") @db.Timestamptz(3)

  @@unique([contaFamiliaId, nomeNormalizado])
  @@index([contaFamiliaId, vencimento])
  @@map("expenses")
}

model PagamentoDespesa {
  id          String   @id @default(uuid()) @db.Uuid
  despesa     Despesa  @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  despesaId   String   @map("expense_id") @db.Uuid
  competencia DateTime @map("reference_month") @db.Date
  pagoPor     User     @relation("PagamentoDespesaPagoPor", fields: [pagoPorId], references: [id])
  pagoPorId   String   @map("paid_by") @db.Uuid
  pagoEm      DateTime @default(now()) @map("paid_at") @db.Timestamptz(3)

  @@unique([despesaId, competencia])
  @@map("expense_payments")
}

model Tag {
  id              String       @id @default(uuid()) @db.Uuid
  contaFamilia    ContaFamilia @relation(fields: [contaFamiliaId], references: [id])
  contaFamiliaId  String       @map("family_account_id") @db.Uuid
  nome            String       @map("name")
  nomeNormalizado String       @map("normalized_name")
  despesas        DespesaTag[]
  criadoEm        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([contaFamiliaId, nomeNormalizado])
  @@map("tags")
}

model DespesaTag {
  despesa   Despesa @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  despesaId String  @map("expense_id") @db.Uuid
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id") @db.Uuid

  @@id([despesaId, tagId])
  @@map("expense_tags")
}
